# Copy to .env for local development. NEVER commit .env (blueprint §23.5).
# Every variable here is validated by envalid at boot; the API refuses to start if one is
# missing or malformed, rather than failing later under load with a confusing error.

NODE_ENV=development
PORT=3000

# Application connection. This role must NOT have BYPASSRLS — tenant isolation depends on it.
DATABASE_URL=postgresql://dukaano_app:dukaano_dev_only@localhost:5433/dukaano?schema=public
# Migration/owner connection. Used by `prisma migrate` only.
DATABASE_ADMIN_URL=postgresql://dukaano:dukaano_dev_only@localhost:5433/dukaano?schema=public

REDIS_URL=redis://localhost:6380

# 32+ byte secrets. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev_only_access_secret_replace_me_with_openssl_rand_base64_48
JWT_REFRESH_SECRET=dev_only_refresh_secret_replace_me_with_openssl_rand_base64_48
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=60

# Comma-separated. Web admin and super admin run on separate hostnames (§8).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

LOG_LEVEL=debug
