// Dukaano — database schema
//
// Implements the ERD approved in docs/dukaano-blueprint.md §16. Read that document before
// changing anything here; several choices below look odd in isolation and are load-bearing.
//
// Conventions applied uniformly across every model:
//
//   • Money columns end in `_paise` and are BIGINT integer paise.        (§15.1, binding)
//   • Quantity columns end in `_milli` and are BIGINT integer            (§15.1, binding)
//     milli-units (scale 10^-3).
//   • Ids are UUIDv7, generated by whichever side creates the row —      (§14.3)
//     including an offline device. No database-generated ids on any
//     entity a client can create.
//   • Every tenant model carries `shop_id` and has `@@unique([shopId, id])`
//     so child tables can reference it with a COMPOSITE foreign key.     (§13 layer 3)
//     This makes cross-tenant FK stitching structurally impossible, not
//     merely unlikely.
//   • Financial models (Sale, Payment, CustomerLedgerEntry,
//     InventoryTransaction) are APPEND-ONLY. They have no soft-delete    (§15.3)
//     column because they have no delete path at all; the application
//     database role holds no DELETE grant on them.
//   • Anything an offline client can create carries a unique `op_id`,    (§14.4)
//     which is the idempotency key.
//
// Row-Level Security is NOT expressed here — Prisma cannot model it. It is applied by a
// dedicated migration (prisma/migrations/*_row_level_security) and verified by a generated
// per-route test suite. See §13.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent, pgcrypto]
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// PLATFORM  —  no shop_id, no RLS, read-only to shop-facing code
// ═══════════════════════════════════════════════════════════════════════════════════════════

model Plan {
  id             String   @id @db.Uuid
  code           String   @unique
  nameEn         String   @map("name_en")
  nameHi         String   @map("name_hi")
  pricePaise     BigInt   @map("price_paise")
  billingPeriod  String   @map("billing_period") // MONTHLY | YEARLY
  trialDays      Int      @default(14) @map("trial_days")
  /// Entitlement keys from @dukaano/types ENTITLEMENTS. Checked independently of permissions.
  entitlements   String[] @default([])
  /// Numeric caps: { maxUsers, maxDevices, maxProducts, monthlyMessages, monthlySales }.
  /// null on a key means unlimited. Kept as JSON so adding a limit is not a migration.
  limits         Json     @default("{}")
  isPublic       Boolean  @default(true) @map("is_public")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("plan")
}

model MasterCategory {
  id       String  @id @db.Uuid
  nameEn   String  @map("name_en")
  nameHi   String  @map("name_hi")
  icon     String?
  sortOrder Int    @default(0) @map("sort_order")
  isActive Boolean @default(true) @map("is_active")

  products MasterProduct[]

  @@map("master_category")
}

/// The platform Kirana catalogue (blueprint §7). Seeding a new shop from this is the single
/// highest-leverage fix for the cold-start problem that is risk R-1.
model MasterProduct {
  id         String   @id @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  nameEn     String   @map("name_en")
  nameHi     String   @map("name_hi")
  /// Romanized search aliases: chini, chawal, atta, namak, tel. Typing "chini" must find चीनी
  /// regardless of the UI language (§22.4).
  aliases    String[] @default([])
  unitCode   String   @map("unit_code")
  /// Indicative only. Every shop sets its own prices — we never share pricing between shops (§7).
  hintPricePaise BigInt? @map("hint_price_paise")
  isCommon   Boolean  @default(false) @map("is_common")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")

  category MasterCategory @relation(fields: [categoryId], references: [id])
  products Product[]

  @@index([categoryId, sortOrder])
  @@map("master_product")
}

/// Super-admin accounts. Deliberately a SEPARATE table from `user` (§8): a platform admin is
/// not a shop membership with extra flags, and the two authorization systems never mix.
model PlatformUser {
  id           String    @id @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  role         String    @default("SUPPORT") // SUPERADMIN | SUPPORT | READONLY
  /// Write-impersonation is granted individually, never by role (§8).
  canImpersonateWrite Boolean @default(false) @map("can_impersonate_write")
  status       String    @default("ACTIVE")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_user")
}

model FeatureFlag {
  id          String   @id @db.Uuid
  key         String   @unique
  description String?
  /// Global default. Per-plan and per-shop targeting live in `targeting`.
  enabled     Boolean  @default(false)
  /// { plans: ["PRO"], shopIds: ["..."], rolloutPercent: 25 }
  targeting   Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flag")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// IDENTITY & TENANCY
// ═══════════════════════════════════════════════════════════════════════════════════════════

model Shop {
  id       String  @id @db.Uuid
  name     String
  shopType String  @default("KIRANA") @map("shop_type")
  phone    String? @db.VarChar(20)
  email    String?
  addressLine String? @map("address_line")
  city     String?
  stateCode String? @map("state_code")
  pincode  String? @db.VarChar(10)
  /// IANA zone. Every timestamp is UTC; "today" is computed in this zone (§25 E-19).
  timezone String  @default("Asia/Kolkata")
  /// 'hi' | 'en'. TEXT rather than an enum so Punjabi is additive (§22.6).
  defaultLocale String @default("hi") @map("default_locale")
  currency String  @default("INR")
  /// Reserved for multi-branch (Phase 2). Tenancy key is already shop_id, so this costs nothing.
  parentShopId String? @map("parent_shop_id") @db.Uuid
  /// Future GST (§5.2). Null for every MVP shop.
  gstin    String? @db.VarChar(15)
  status   String  @default("TRIAL")
  /// 30-day recoverable window; a shop is never hard-deleted (§27.4).
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  settings      ShopSettings?
  memberships   ShopMembership[]
  devices       Device[]
  subscriptions Subscription[]
  categories    Category[]
  products      Product[]
  customers     Customer[]
  suppliers     Supplier[]
  sales         Sale[]
  payments      Payment[]
  ledgerEntries CustomerLedgerEntry[]
  inventoryTransactions InventoryTransaction[]
  inventoryBalances     InventoryBalance[]
  customerBalances      CustomerBalance[]
  numberLeases  NumberLease[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([status])
  @@map("shop")
}

model ShopSettings {
  shopId String @id @map("shop_id") @db.Uuid

  /// §17.3. ALLOW is the default: refusing to record a sale that physically happened destroys
  /// financial truth to protect a stock number. BLOCK is offered but is unenforceable offline,
  /// and the settings UI says so rather than implying a guarantee we cannot keep.
  negativeStockPolicy String @default("ALLOW") @map("negative_stock_policy")

  /// §15.1 / §25 E-23. NONE | NEAREST_RUPEE | NEAREST_5_RUPEES.
  roundingPolicy String @default("NONE") @map("rounding_policy")

  /// §25 E-20. Hour 0–23 at which the shop's business day rolls over. A shop open past midnight
  /// sets this to 4 so a 00:30 sale counts as the previous day's takings.
  businessDayStartHour Int @default(0) @map("business_day_start_hour")

  /// §20.1. WA_DEEPLINK costs ₹0 and needs no Meta verification or TRAI DLT registration.
  /// Server-sent channels are gated by a feature flag until compliance is done.
  messagingChannel String  @default("WA_DEEPLINK") @map("messaging_channel")
  receiptFooter    String? @map("receipt_footer")
  sendReceiptByDefault Boolean @default(true) @map("send_receipt_by_default")
  /// §20.5. Protects the shopkeeper's relationship with their customer. An over-eager reminder
  /// feature loses the shop its customers, and then loses us the shop.
  reminderCooldownDays Int @default(7) @map("reminder_cooldown_days")

  /// Applied to a new product when the shopkeeper does not set one.
  defaultLowStockThresholdMilli BigInt @default(0) @map("default_low_stock_threshold_milli")
  /// Cap on the discount a permission-holding cashier may apply, in basis points.
  maxCashierDiscountBp Int @default(0) @map("max_cashier_discount_bp")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("shop_settings")
}

model User {
  id           String    @id @db.Uuid
  /// E.164, normalized on write (§25 E-16). The primary login identifier in India.
  phoneE164    String?   @unique @map("phone_e164") @db.VarChar(20)
  email        String?   @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  locale       String?
  status       String    @default("ACTIVE")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships ShopMembership[]
  sessions    Session[]
  devices     Device[]

  @@map("user")
}

/// Many-to-many: one account may belong to several shops (§25 E-36). The JWT is scoped to one
/// active shop at a time and a shop switcher re-issues it.
model ShopMembership {
  id       String @id @db.Uuid
  shopId   String @map("shop_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  role     String // OWNER | MANAGER | CASHIER
  /// { grant: [...], revoke: [...] }. The ROLE_CEILING in @dukaano/business-logic is applied
  /// AFTER these, server-side, so a corrupted value here can never escalate a Cashier (§9.2).
  permissionOverrides Json @default("{}") @map("permission_overrides")
  status   String @default("ACTIVE")
  invitedByUserId String? @map("invited_by_user_id") @db.Uuid
  joinedAt DateTime? @map("joined_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@unique([shopId, id])
  @@index([userId, status])
  @@map("shop_membership")
}

/// Refresh tokens. Stored HASHED, rotated on every use, with reuse detection (§23.1): presenting
/// a rotated token twice revokes the whole family. These devices get lost and shared, so this
/// matters more here than in a typical B2B SaaS.
model Session {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceId     String?   @map("device_id") @db.Uuid
  /// SHA-256 of the opaque refresh token. The plaintext is never stored.
  tokenHash    String    @unique @map("token_hash")
  /// All tokens rotated from one login share a family id, so reuse revokes the lineage.
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?  @map("revoked_reason")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("session")
}

model Device {
  id         String    @id @db.Uuid
  shopId     String    @map("shop_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  name       String?
  platform   String // ANDROID | IOS | WEB
  appVersion String?   @map("app_version")
  osVersion  String?   @map("os_version")
  pushToken  String?   @map("push_token")
  /// §14.5. The xmin watermark this device has pulled up to. Stored as text because Prisma
  /// cannot model xid8; the sync module reads and writes it with raw SQL.
  lastSyncXmin String?  @map("last_sync_xmin")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  /// §25 E-26. Set when the device's clock was too far off to trust for business dating.
  clockSkewMs Int?     @map("clock_skew_ms")
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop     Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessions Session[]
  leases   NumberLease[]

  @@unique([shopId, id])
  @@index([shopId, revokedAt])
  @@map("device")
}

/// §14.6. An offline device cannot call a server sequence, but the receipt in the customer's
/// hand needs a final invoice number. Each device leases a block of numbers and draws from it
/// offline. Gaps are expected and the web admin explains this once — the alternative (assigning
/// numbers at sync time) means the customer's copy and our record disagree, which is far worse.
model NumberLease {
  id         String    @id @db.Uuid
  shopId     String    @map("shop_id") @db.Uuid
  deviceId   String    @map("device_id") @db.Uuid
  series     String    @default("INV")
  rangeFrom  Int       @map("range_from")
  rangeTo    Int       @map("range_to")
  nextValue  Int       @map("next_value")
  issuedAt   DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  exhaustedAt DateTime? @map("exhausted_at") @db.Timestamptz(3)

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [shopId, deviceId], references: [shopId, id], onDelete: Cascade)

  @@unique([shopId, series, rangeFrom])
  @@index([shopId, deviceId, exhaustedAt])
  @@map("number_lease")
}

model Subscription {
  id        String    @id @db.Uuid
  shopId    String    @map("shop_id") @db.Uuid
  planId    String    @map("plan_id") @db.Uuid
  status    String    @default("TRIALING")
  trialEndsAt DateTime? @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodStart DateTime @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime @map("current_period_end") @db.Timestamptz(3)
  /// §25 E-32. Offline ops are ALWAYS accepted even past expiry — we never hold a shop's real
  /// transactions hostage. The shop drops to read-only for NEW work after the grace period.
  graceUntil DateTime? @map("grace_until") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([shopId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscription")
}

/// Metered usage against plan limits, bucketed by billing period.
model UsageCounter {
  id     String @id @db.Uuid
  shopId String @map("shop_id") @db.Uuid
  /// 'YYYY-MM' in the shop's timezone.
  period String
  metric String // messages_sent | sales_created | products_created
  count  Int    @default(0)

  @@unique([shopId, period, metric])
  @@map("usage_counter")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// CATALOGUE
// ═══════════════════════════════════════════════════════════════════════════════════════════

model Category {
  id       String  @id @db.Uuid
  shopId   String  @map("shop_id") @db.Uuid
  masterCategoryId String? @map("master_category_id") @db.Uuid
  nameEn   String? @map("name_en")
  nameHi   String? @map("name_hi")
  sortOrder Int    @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([shopId, id])
  @@index([shopId, archivedAt])
  @@map("category")
}

model Product {
  id       String  @id @db.Uuid
  shopId   String  @map("shop_id") @db.Uuid
  masterProductId String? @map("master_product_id") @db.Uuid
  categoryId String? @map("category_id") @db.Uuid

  /// At least one of the two is required — enforced by a CHECK constraint (see the RLS/constraints
  /// migration). We never auto-translate a shopkeeper's product name (§22.4).
  nameEn   String? @map("name_en")
  nameHi   String? @map("name_hi")

  sku       String?
  shortCode String? @map("short_code")
  /// Phase 2. Indexed now so enabling the scanner is not a migration (§5.2).
  barcode   String?

  unitCode  String  @map("unit_code")

  sellingPricePaise  BigInt  @map("selling_price_paise")
  /// Visible only with the `product.view.cost` permission, which a Cashier can NEVER hold (§9.2).
  purchasePricePaise BigInt? @map("purchase_price_paise")
  mrpPaise           BigInt? @map("mrp_paise")

  lowStockThresholdMilli BigInt @default(0) @map("low_stock_threshold_milli")

  /// Phase 2 GST. Basis points, default 0 (§5.2).
  taxRateBp Int     @default(0) @map("tax_rate_bp")
  hsnCode   String? @map("hsn_code")

  isActive   Boolean   @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  /// §14.7. Bumped on every server-applied change; the sync cursor and conflict detection use it.
  rowVersion BigInt   @default(1) @map("row_version")
  /// §14.7. The client's edit time, used for last-writer-wins on non-price fields.
  clientUpdatedAt DateTime? @map("client_updated_at") @db.Timestamptz(3)
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  updatedByUserId String? @map("updated_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop     Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category Category?      @relation(fields: [shopId, categoryId], references: [shopId, id], onDelete: SetNull)
  master   MasterProduct? @relation(fields: [masterProductId], references: [id], onDelete: SetNull)
  aliases  ProductAlias[]
  balance  InventoryBalance?
  inventoryTransactions InventoryTransaction[]
  saleItems SaleItem[]

  @@unique([shopId, id])
  @@index([shopId, isActive])
  @@index([shopId, categoryId])
  @@map("product")
}

/// Extra search keywords, including romanized Hindi. Typing "chini" finds चीनी (§22.4).
model ProductAlias {
  id        String @id @db.Uuid
  shopId    String @map("shop_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  alias     String

  product Product @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Cascade)

  @@unique([shopId, productId, alias])
  @@index([shopId])
  @@map("product_alias")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// INVENTORY  —  append-only log + snapshot (§17)
// ═══════════════════════════════════════════════════════════════════════════════════════════

/// The ONLY writer of this table is the inventory service, and only alongside an
/// InventoryTransaction insert, under a FOR UPDATE lock on this row (§17.2). A nightly
/// reconciliation job asserts qty_milli == SUM(inventory_transaction.qty_delta_milli) and
/// alerts P1 on a mismatch — it does not auto-heal, because drift means a bug in the write path
/// and auto-healing would hide it.
model InventoryBalance {
  shopId    String @map("shop_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  /// May be NEGATIVE. This is a deliberate, documented state (§17.3, §14.8).
  qtyMilli      BigInt @default(0) @map("qty_milli")
  /// Moving average cost. Enables valuation now and the Phase-2 profit report without a migration.
  avgCostPaise  BigInt @default(0) @map("avg_cost_paise")
  /// Optimistic-lock counter, incremented on every update.
  version       BigInt @default(0)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Cascade)

  @@id([shopId, productId])
  @@map("inventory_balance")
}

/// Append-only. No UPDATE, no DELETE — a correction is a new row (§17).
model InventoryTransaction {
  id        String @id @db.Uuid
  shopId    String @map("shop_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  type          String // see INVENTORY_TRANSACTION_TYPES in @dukaano/types
  /// Signed. Negative for outbound movements.
  qtyDeltaMilli BigInt @map("qty_delta_milli")
  /// Server-assigned at apply time, NOT trusted from the client: server order is arrival order,
  /// not client order (§14.7).
  balanceAfterMilli BigInt @map("balance_after_milli")
  /// Captured on inbound movements with a known cost; drives the moving average.
  unitCostPaise BigInt? @map("unit_cost_paise")

  refType String? @map("ref_type") // SALE | PURCHASE | SALE_RETURN | ...
  refId   String? @map("ref_id") @db.Uuid
  /// Mandatory for DAMAGE, WASTAGE, ADJUSTMENT and CORRECTION (§17.1).
  reason  String?
  note    String?

  actorUserId String?  @map("actor_user_id") @db.Uuid
  deviceId    String?  @map("device_id") @db.Uuid
  /// Business time. May be backdated by an offline device (§25 E-26).
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Idempotency key for offline replay (§14.4).
  opId        String?  @unique @map("op_id") @db.Uuid

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [shopId, productId], references: [shopId, id])

  @@index([shopId, productId, occurredAt(sort: Desc), id])
  @@index([shopId, occurredAt(sort: Desc)])
  @@index([shopId, refType, refId])
  @@map("inventory_transaction")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// CUSTOMERS & KHATA  —  append-only ledger + snapshot (§18)
// ═══════════════════════════════════════════════════════════════════════════════════════════

model Customer {
  id     String @id @db.Uuid
  shopId String @map("shop_id") @db.Uuid
  name   String
  /// Normalized to E.164 before comparison so "9876543210", "+919876543210" and "098765 43210"
  /// are one customer, not three (§25 E-16).
  phoneE164 String? @map("phone_e164") @db.VarChar(20)
  address String?
  notes   String?
  /// §25 E-34. Exceeding this warns with a permissioned, audited override — never a hard block.
  creditLimitPaise BigInt? @map("credit_limit_paise")
  /// §20.5. Opt-out is honoured for reminders as well as receipts.
  messagingOptedOutAt DateTime? @map("messaging_opted_out_at") @db.Timestamptz(3)

  isActive   Boolean   @default(true) @map("is_active")
  /// §25 E-8. Archiving is BLOCKED while the customer has an outstanding balance.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  rowVersion      BigInt    @default(1) @map("row_version")
  clientUpdatedAt DateTime? @map("client_updated_at") @db.Timestamptz(3)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop     Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  balance  CustomerBalance?
  sales    Sale[]
  payments Payment[]
  ledgerEntries CustomerLedgerEntry[]

  @@unique([shopId, id])
  @@index([shopId, archivedAt])
  @@map("customer")
}

/// Written ONLY by the ledger service, only alongside a CustomerLedgerEntry insert, under a
/// FOR UPDATE lock on this row (§18.1). Never assigned from a client value.
model CustomerBalance {
  shopId     String @map("shop_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid

  /// Positive = customer owes the shop. Negative = advance paid (§25 E-33), displayed as
  /// "जमा / advance", never as an error.
  outstandingPaise BigInt @default(0) @map("outstanding_paise")
  lastEntryId      String? @map("last_entry_id") @db.Uuid
  lastActivityAt   DateTime? @map("last_activity_at") @db.Timestamptz(3)
  version          BigInt @default(0)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [shopId, customerId], references: [shopId, id], onDelete: Cascade)

  @@id([shopId, customerId])
  @@index([shopId, outstandingPaise(sort: Desc)])
  @@map("customer_balance")
}

/// Append-only. A mistake is corrected by appending a reversing entry, never by editing (§18.1).
model CustomerLedgerEntry {
  id         String @id @db.Uuid
  shopId     String @map("shop_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid

  entryType String @map("entry_type") // see LEDGER_ENTRY_TYPES in @dukaano/types
  /// SIGNED: positive increases what the customer owes, negative decreases it.
  amountPaise BigInt @map("amount_paise")
  /// Assigned INSIDE the balance row lock, so replaying entries in insertion order reproduces a
  /// coherent running balance for statements (§18.1 rule 4).
  balanceAfterPaise BigInt @map("balance_after_paise")

  refType String? @map("ref_type") // SALE | PAYMENT | SALE_RETURN
  refId   String? @map("ref_id") @db.Uuid
  reason  String?
  note    String?

  actorUserId String?  @map("actor_user_id") @db.Uuid
  deviceId    String?  @map("device_id") @db.Uuid
  /// Business time — may be backdated. Statements sort by this; the running balance follows
  /// insertion order. Both are shown when they differ (§18.1 rule 5).
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  opId        String?  @unique @map("op_id") @db.Uuid

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [shopId, customerId], references: [shopId, id])

  @@index([shopId, customerId, occurredAt(sort: Desc), id])
  @@index([shopId, refType, refId])
  @@map("customer_ledger_entry")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// SALES  (§19)
// ═══════════════════════════════════════════════════════════════════════════════════════════

model Sale {
  id     String @id @db.Uuid
  shopId String @map("shop_id") @db.Uuid
  /// Drawn from the device's number lease so the printed number is final offline (§14.6).
  saleNumber String @map("sale_number")
  customerId String? @map("customer_id") @db.Uuid

  /// COMPLETED | CANCELLED. Never deleted (§25 E-12).
  status String @default("COMPLETED")

  subtotalPaise            BigInt @map("subtotal_paise")
  lineDiscountPaise        BigInt @default(0) @map("line_discount_paise")
  billDiscountPaise        BigInt @default(0) @map("bill_discount_paise")
  /// Stored, never an implicit truncation, so the bill always reconciles (§15.1).
  roundingAdjustmentPaise  BigInt @default(0) @map("rounding_adjustment_paise")
  totalPaise               BigInt @map("total_paise")
  /// Maintained snapshot of SUM(payment.amount_paise) for this sale; reconciled nightly.
  paidPaise                BigInt @default(0) @map("paid_paise")
  /// total - paid. Requires a customer when non-zero (CHECK constraint + service assertion).
  creditPaise              BigInt @default(0) @map("credit_paise")

  /// Computed in the shop timezone at write time and STORED. Reports read this column and never
  /// re-derive it — re-deriving would let a timezone change rewrite history (§25 E-19).
  businessDate DateTime @map("business_date") @db.Date
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(3)

  source   String  @default("MOBILE")
  /// §14.8. Set when this sale drove the balance negative, so the shopkeeper can be prompted.
  droveStockNegative Boolean @default(false) @map("drove_stock_negative")
  notes    String?

  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId String? @map("cancelled_by_user_id") @db.Uuid
  cancelReason    String?   @map("cancel_reason")

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  deviceId        String?  @map("device_id") @db.Uuid
  opId            String?  @unique @map("op_id") @db.Uuid
  rowVersion      BigInt   @default(1) @map("row_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [shopId, customerId], references: [shopId, id])
  items    SaleItem[]
  payments Payment[]
  allocations PaymentAllocation[]

  @@unique([shopId, id])
  @@unique([shopId, saleNumber])
  @@index([shopId, businessDate(sort: Desc)])
  @@index([shopId, customerId, occurredAt(sort: Desc)])
  @@index([shopId, createdByUserId, businessDate])
  @@index([shopId, status])
  @@map("sale")
}

model SaleItem {
  id     String @id @db.Uuid
  shopId String @map("shop_id") @db.Uuid
  saleId String @map("sale_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  /// Snapshots, so an archived or renamed product still renders an old bill correctly (§25 E-9).
  productNameSnapshot String @map("product_name_snapshot")
  unitSnapshot        String @map("unit_snapshot")

  qtyMilli       BigInt @map("qty_milli")
  /// The price the customer was quoted. A later price change never touches this (§25 E-4, E-10).
  unitPricePaise BigInt @map("unit_price_paise")
  discountPaise  BigInt @default(0) @map("discount_paise")
  lineTotalPaise BigInt @map("line_total_paise")
  /// Moving-average cost at the moment of sale. Captured in MVP even though the gross-profit
  /// report is Phase 2 — profit is unrecoverable retroactively (§4.1).
  costPaiseSnapshot BigInt? @map("cost_paise_snapshot")

  sortOrder Int @default(0) @map("sort_order")

  sale    Sale    @relation(fields: [shopId, saleId], references: [shopId, id], onDelete: Cascade)
  product Product @relation(fields: [shopId, productId], references: [shopId, id])

  @@index([shopId, saleId])
  @@index([shopId, productId, saleId])
  @@map("sale_item")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// PAYMENTS  (§19)
// ═══════════════════════════════════════════════════════════════════════════════════════════

/// A payment row is REAL MONEY MOVING. "Udhaar" is a payment *selection* in the UI but produces
/// a CustomerLedgerEntry, never a row here (§19.1, binding). Adding 'UDHAAR' to the method list
/// is the single most likely way to reintroduce the double-counting bug this design prevents.
///
/// A payment is never edited or deleted: a mistake is fixed with a reversing row that sets
/// reversed_by_payment_id on the original, plus a PAYMENT_REVERSED ledger entry (§19.3).
model Payment {
  id         String @id @db.Uuid
  shopId     String @map("shop_id") @db.Uuid
  customerId String? @map("customer_id") @db.Uuid
  /// NULL + customerId present = a khata collection, allocated across bills (§18.4).
  saleId     String? @map("sale_id") @db.Uuid

  direction String // IN (from customer) | OUT (refund)
  method    String // CASH | UPI | CARD | BANK_TRANSFER | OTHER
  /// Always POSITIVE; `direction` carries the sign semantics.
  amountPaise BigInt @map("amount_paise")
  /// Optional UPI reference. Never mandatory — the shopkeeper is looking at their PhonePe screen,
  /// not typing a UTR (§10 J5).
  reference String?
  note      String?

  businessDate DateTime @map("business_date") @db.Date
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(3)

  reversedByPaymentId String? @unique @map("reversed_by_payment_id") @db.Uuid
  reversalOfPaymentId String? @map("reversal_of_payment_id") @db.Uuid

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  deviceId        String?  @map("device_id") @db.Uuid
  opId            String?  @unique @map("op_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [shopId, customerId], references: [shopId, id])
  sale     Sale?     @relation(fields: [shopId, saleId], references: [shopId, id])
  allocations PaymentAllocation[]

  @@unique([shopId, id])
  @@index([shopId, businessDate(sort: Desc), method])
  @@index([shopId, customerId, occurredAt(sort: Desc)])
  @@index([shopId, saleId])
  @@map("payment")
}

/// Which bills a khata collection cleared. FIFO by default, manually overridable on web.
/// Without these rows, "which bills are still open?" and the ageing report are unanswerable.
model PaymentAllocation {
  id        String @id @db.Uuid
  shopId    String @map("shop_id") @db.Uuid
  paymentId String @map("payment_id") @db.Uuid
  saleId    String @map("sale_id") @db.Uuid
  amountPaise BigInt @map("amount_paise")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [shopId, paymentId], references: [shopId, id], onDelete: Cascade)
  sale    Sale    @relation(fields: [shopId, saleId], references: [shopId, id])

  @@unique([shopId, paymentId, saleId])
  @@index([shopId, saleId])
  @@map("payment_allocation")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// SUPPLIERS  (§15, Phase 7 — tables created now so RLS and FK patterns are applied uniformly)
// ═══════════════════════════════════════════════════════════════════════════════════════════

model Supplier {
  id     String @id @db.Uuid
  shopId String @map("shop_id") @db.Uuid
  name   String
  phoneE164 String? @map("phone_e164") @db.VarChar(20)
  address String?
  gstin   String? @db.VarChar(15)
  notes   String?
  isActive Boolean @default(true) @map("is_active")
  /// §25 E-24. Soft-archive only; blocked while unpaid purchases exist.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  rowVersion BigInt @default(1) @map("row_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, id])
  @@index([shopId, archivedAt])
  @@map("supplier")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// SYNC & OPS  (§14)
// ═══════════════════════════════════════════════════════════════════════════════════════════

/// The idempotency ledger. An INSERT ... ON CONFLICT DO NOTHING here is the entire duplicate-sale
/// defence: if the row already exists, the stored original result is returned unchanged (§14.4).
/// Shared by the sync path and by the Idempotency-Key header on ordinary POSTs — one mechanism,
/// not two. Pruned after 90 days; a device staler than that is forced to bootstrap anyway.
model ProcessedOperation {
  opId       String   @id @map("op_id") @db.Uuid
  shopId     String   @map("shop_id") @db.Uuid
  deviceId   String?  @map("device_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  entity     String
  entityId   String?  @map("entity_id") @db.Uuid
  opType     String   @map("op_type")
  status     String   // applied | rejected | conflict
  /// The response returned the first time. Replays get this back verbatim.
  result     Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([shopId, createdAt])
  @@index([createdAt])
  @@map("processed_operation")
}

/// Written in the SAME transaction as every tenant mutation. Drives delta pull.
///
/// `txid` is the reason this table exists rather than a plain `updated_at` cursor. BIGSERIAL ids
/// are allocated at INSERT but become visible at COMMIT, so a transaction holding id 100 can
/// commit AFTER one holding id 105. A cursor keyed on `id` would serve 105, advance past it, and
/// permanently lose row 100 — a silently missing sale on a shopkeeper's device. The cursor is
/// therefore an xmin watermark: see the raw query in the sync module and blueprint §14.5.
model ChangeLog {
  id         BigInt   @id @default(autoincrement())
  shopId     String   @map("shop_id") @db.Uuid
  entity     String
  entityId   String   @map("entity_id") @db.Uuid
  op         String   // upsert | archive
  rowVersion BigInt   @map("row_version")
  /// Prisma cannot model xid8. Populated by a column DEFAULT of pg_current_xact_id() and read
  /// only via raw SQL in the sync module.
  txid       Unsupported("xid8")
  changedAt  DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  @@index([shopId, txid, id])
  @@map("change_log")
}

/// Surfaced to the shopkeeper as a "conflict inbox". Nothing is ever discarded silently (§14.9).
model SyncConflict {
  id         String   @id @db.Uuid
  shopId     String   @map("shop_id") @db.Uuid
  deviceId   String?  @map("device_id") @db.Uuid
  entity     String
  entityId   String   @map("entity_id") @db.Uuid
  clientPayload Json  @map("client_payload")
  serverPayload Json  @map("server_payload")
  resolution String   // server_wins | client_wins | manual
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([shopId, acknowledgedAt])
  @@map("sync_conflict")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// AUDIT & NOTIFICATIONS  (§28)
// ═══════════════════════════════════════════════════════════════════════════════════════════

model AuditLog {
  id     String  @id @db.Uuid
  shopId String? @map("shop_id") @db.Uuid

  actorType   String  @map("actor_type") // USER | PLATFORM_ADMIN | SYSTEM
  actorUserId String? @map("actor_user_id") @db.Uuid
  /// §8. Stamped on every row when a platform admin is impersonating, so support activity is
  /// always distinguishable from the shopkeeper's own actions.
  actingAsAdminId String? @map("acting_as_admin_id") @db.Uuid

  action     String // product.price.changed | sale.cancelled | ledger.adjusted | ...
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id") @db.Uuid

  /// Redacted before write — never contains password hashes, tokens or full phone numbers.
  before Json?
  after  Json?

  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  requestId String?  @map("request_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt(sort: Desc)])
  @@index([shopId, entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_log")
}

model Notification {
  id     String  @id @db.Uuid
  shopId String  @map("shop_id") @db.Uuid
  /// Null = for everyone in the shop.
  userId String? @map("user_id") @db.Uuid

  type     String // LOW_STOCK | SYNC_FAILED | MESSAGE_FAILED | STOCK_MISMATCH | SUBSCRIPTION_EXPIRING
  severity String @default("INFO") // INFO | WARNING | CRITICAL
  /// i18n key + params rather than rendered prose, so the notification renders in whichever
  /// language the reader has selected, not the language of whoever triggered it (§22.2).
  titleKey  String @map("title_key")
  bodyKey   String @map("body_key")
  params    Json   @default("{}")
  actionUrl String? @map("action_url")

  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, userId, readAt])
  @@index([shopId, createdAt(sort: Desc)])
  @@map("notification")
}
