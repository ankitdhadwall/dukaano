{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    // CommonJS across the board. NestJS relies on `emitDecoratorMetadata`, which is only
    // reliable under CJS emit; Next.js and Expo bundlers consume CJS packages without issue.
    // Choosing one module system for every workspace package avoids dual-package hazards.
    "module": "CommonJS",
    "moduleResolution": "Node",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "dist", ".turbo", "coverage"]
}
